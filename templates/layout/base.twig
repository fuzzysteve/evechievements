<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EVEchievements{% endblock %} · Capsuleer Registry</title>
    {# Icons live under /assets/: the vhost sends every other path to PHP #}
    <link rel="icon" href="{{ asset('/assets/icons/favicon.ico') }}" sizes="32x32">
    <link rel="icon" href="{{ asset('/assets/icons/favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('/assets/icons/apple-touch-icon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('/assets/css/app.css') }}">
    {% block head %}{% endblock %}
</head>
<body>
<nav class="topnav">
    <div class="topnav__brand"><a href="/">
        <span class="topnav__logo-icon">◇</span>
        <span class="topnav__logo-main">EVE<span class="topnav__logo-accent">CHIEVEMENTS</span></span>
        <span class="topnav__logo-sub">.ONLINE · CAPSULEER REGISTRY</span></a>
    </div>
    <ul class="topnav__links">
        <li><a href="/"       class="topnav__link">HOME</a></li>
        <li><a href="/browse" class="topnav__link">BROWSE</a></li>
        {% if app.session.pilot_id is defined %}<li><a href="/dashboard" class="topnav__link">DASHBOARD</a></li>{% endif %}
    </ul>
    {# Suggestions come from /search.json (app.js); without JS, Enter goes to the results page #}
    <form class="topnav__search" action="/search" method="get" role="search">
        <label for="site-search" class="visually-hidden">Search pilots and ships</label>
        <input type="search" id="site-search" name="q" class="topnav__search-input"
               placeholder="Search pilots or ships…" autocomplete="off" maxlength="100"
               value="{{ query is defined ? query }}"
               aria-controls="site-search-results" aria-expanded="false">
        <div id="site-search-results" class="search-suggest" hidden></div>
    </form>
    <div class="topnav__status">
        {% if session.pilot_id is defined and session.pilot_id %}
            <a href="/auth/logout" class="btn btn--outline btn--sm">LOGOUT</a>
        {% else %}
            <a href="/auth/login" class="btn btn--primary btn--sm">AUTHENTICATE</a>
        {% endif %}
    </div>
</nav>
<main>{% block content %}{% endblock %}</main>
<footer class="footer">
    <div class="footer__inner">
        <p>EVEchievements is not affiliated with CCP Games. EVE Online is property of CCP hf.</p>
    </div>
    <div class="footer__inner">
        <p><a href="https://store.markeedragon.com/affiliate.php?id=250&redirect=index.php?cat=4"> Get your Eve Online Products at Markee Dragon Game Codes!</a></p>
    </div>
</footer>
<script src="{{ asset('/assets/js/app.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
