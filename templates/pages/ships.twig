{% extends "layout/base.twig" %}
{% block title %}{{ faction.name }} ship tree{% endblock %}

{# Link preview: generic SDE data only, nothing about any pilot #}
{% block head %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="EVEchievements">
    <meta property="og:title" content="{{ faction.name }} ship tree">
    <meta property="og:description" content="All {{ faction.ship_count }} {{ faction.name }} ships, laid out as in-game.{{ faction.description ? ' ' ~ faction.description }}">
    <meta property="og:url" content="{{ app_url }}/ships?faction={{ faction.faction_id }}">
    <meta property="og:image" content="https://images.evetech.net/corporations/{{ faction.corporation_id }}/logo?size=128">
    <meta name="theme-color" content="#f4a228">
{% endblock %}

{% import 'partials/ship_tree.twig' as tree %}

{% block content %}
<div class="shiptree">

    <header class="shiptree__header">
        <div class="shiptree__pilot">
            <img src="https://images.evetech.net/corporations/{{ faction.corporation_id }}/logo?size=64" alt="">
            <div>
                <span class="shiptree__eyebrow">◇ SHIP TREES</span>
                <h1 class="shiptree__pilot-name">{{ faction.name }}</h1>
            </div>
        </div>
    </header>

    {# The viewer's own state comes from their session only: shown only to them, never stored #}
    {% if viewer == 'ready' %}
    <div class="view-switch">
        <nav class="level-tabs view-switch__tabs" aria-label="Tree view">
            <a href="?faction={{ faction.faction_id }}" class="level-tab{{ not view_all ? ' level-tab--active' }}"{{ not view_all ? ' aria-current="page"' }}>MY SKILLS</a>
            <a href="?faction={{ faction.faction_id }}&amp;view=all" class="level-tab{{ view_all ? ' level-tab--active' }}"{{ view_all ? ' aria-current="page"' }}>ALL SHIPS</a>
        </nav>
        {% if not view_all %}<span class="view-switch__note">Your skills, from your current session. Only you can see this.</span>{% endif %}
    </div>
    {% elseif viewer == 'no_skills' %}
    <p class="viewer-note">Load your skills on the <a href="/dashboard">dashboard</a> to see this tree with what you can fly. Only you see that.</p>
    {% elseif viewer == 'stale' %}
    <p class="viewer-note">Your loaded skills predate ship trees. ↻ Refresh them on the <a href="/dashboard">dashboard</a> to see this tree with what you can fly.</p>
    {% endif %}

    <nav class="shiptree__factions" aria-label="Factions">
        {% for f in factions %}
        <a href="?faction={{ f.faction_id }}{{ view_all ? '&view=all' }}"
           class="faction-tab{{ f.faction_id == faction.faction_id ? ' faction-tab--active' }}"
           {{ f.faction_id == faction.faction_id ? 'aria-current="page"' }}>
            <img src="https://images.evetech.net/corporations/{{ f.corporation_id }}/logo?size=32" alt="">
            <span class="faction-tab__name">{{ f.name }}</span>
            <span class="faction-tab__count">{{ summary ? summary[f.faction_id].flyable ~ '/' ~ summary[f.faction_id].total : f.ship_count }}</span>
        </a>
        {% endfor %}
    </nav>

    <div class="shiptree__summary">
        <div class="stat-row">
            {% if summary %}
            {% set mine = summary[faction.faction_id] %}
            <div class="stat">
                <span class="stat__value">{{ mine.flyable }} / {{ mine.total }}</span>
                <span class="stat__label">SHIPS YOU CAN FLY</span>
            </div>
            <div class="stat">
                <span class="stat__value">{{ mine.mastered }}</span>
                <span class="stat__label">MASTERY V</span>
            </div>
            {% else %}
            <div class="stat">
                <span class="stat__value">{{ faction.ship_count }}</span>
                <span class="stat__label">SHIPS</span>
            </div>
            {% endif %}
        </div>
        {% if faction.description %}
        <p class="shiptree__description">{{ faction.description }}</p>
        {% endif %}
    </div>

    {{ tree.canvas(layout, levels) }}

    <ul class="shiptree__legend">
        <li><span class="ship-tile__badge ship-tile__badge--t2">II</span> Tech II</li>
        <li><span class="ship-tile__badge ship-tile__badge--t3">III</span> Tech III</li>
        <li><span class="ship-tile__badge ship-tile__badge--faction">◆</span> Navy / faction</li>
        {% if levels is not null %}
        <li><span class="legend-swatch legend-swatch--mastered"></span> Mastery V</li>
        <li><span class="legend-swatch legend-swatch--locked"></span> You can't fly</li>
        <li><span class="legend-line"></span> Path to ships you can fly</li>
        {% endif %}
        <li>Hover a class name for its required skills · click a ship for its mastery requirements, attributes and bonuses</li>
    </ul>

</div>
{% endblock %}
