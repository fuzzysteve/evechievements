{% extends "layout/base.twig" %}
{% block title %}{{ pilot.name }}{% endblock %}
{% block content %}
<div class="profile">
    <header class="profile__header">
        <div class="profile__portrait">
            <div class="pilot-thumb__portrait">
                <img src="https://images.evetech.net/characters/{{ pilot.id }}/portrait?size=64" alt="{{ pilot.name }}">
            </div>
        </div>
        <div class="profile__identity">
            <h1 class="profile__name">{{ pilot.name }}</h1>
            {% if pilot.corporation_name %}<p class="profile__corp">{{ pilot.corporation_name }}{% if pilot.alliance_name %} · {{ pilot.alliance_name }}{% endif %}</p>{% endif %}
        </div>
        <div class="profile__stats">
            {% if stats.total_sp != -1 %}
            <div class="stat"><span class="stat__value">{{ (stats.total_sp / 1000000)|number_format(1) }}M</span><span class="stat__label">SP</span></div>
            {% endif %}
            {% if stats.total_isk != -1 %}
            <div class="stat"><span class="stat__value">{{ (stats.total_isk / 1000000)|number_format(1) }}M</span><span class="stat__label">ISK</span></div>
            {% endif %}
            {% if stats.birthday %}<div class="stat"><span class="stat__value">{{ date().diff(date(stats.birthday)).y }}y</span><span class="stat__label">IN AGE</span></div>{% endif %}
        </div>
    </header>

</div>
{% endblock %}
