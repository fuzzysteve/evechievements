{% extends "layout/base.twig" %}
{% block title %}EVEchievements{% endblock %}
{% block content %}
{% set login_errors = {
    no_code:       'EVE login was cancelled or didn\'t return a code. Try again.',
    invalid_token: 'EVE login returned a token we couldn\'t read. Try again.',
    auth_failed:   'Logging in with EVE failed. Try again in a moment.',
} %}
{% if login_errors[error] is defined %}
<div class="home-alert"><div class="alert alert--error" role="alert">{{ login_errors[error] }}</div></div>
{% endif %}
<section class="hero">
    <div class="hero__left">
        <p class="hero__eyebrow">◇ THIRD-PARTY CAPSULEER REGISTRY</p>
        <h1 class="hero__headline">
            <span class="hero__headline-accent">Every trophy</span><br>
            on the record.
        </h1>
        <p class="hero__sub">Connect your pilot, opt-in to what's public, and let other capsuleers browse your career.</p>
        <div class="hero__cta">
            <a href="/auth/login" class="btn btn--primary">→ AUTHENTICATE VIA ESI</a>
            <a href="/pilot/90926985"     class="btn btn--outline">VIEW EXAMPLE PROFILE</a>
        </div>
        <p class="hero__stats">· {{ total_pilots|number_format }} pilots indexed &nbsp;· {{ public_pilots|number_format }} public profiles</p>
    </div>
    <div class="hero__right">
        <p class="hero__card-label">◇ EXAMPLE / Steve Ronuken</p>
        <div class="pilot-card pilot-card--hero">
            <div class="pilot-card__portrait"><img src="https://images.evetech.net/characters/90926985/portrait?size=64"></div>
            <div class="pilot-card__info">
                <h2 class="pilot-card__name">Steve Ronuken</h2>
                <p class="pilot-card__corp">Fuzzwork Enterprises [FZZW] · Vote Steve Ronuken for CSM [VOTE]</p>
                <div class="pilot-card__badges">
                </div>
            </div>
            <div class="pilot-card__stats">
                <div class="stat"><span class="stat__value">281M</span><span class="stat__label">SP</span></div>
                <div class="stat"><span class="stat__value">24.2B</span><span class="stat__label">ISK</span></div>
                <div class="stat"><span class="stat__value">285</span><span class="stat__label">Achievement Score</span></div>
            </div>
        </div>
    </div>
</section>

<section class="features">
    <div class="feature"><span class="feature__num">01 ——</span><h3>ESI does the work</h3><p>Authenticate when you want to update your card, we don't retain your credentials.</p></div>
    <div class="feature"><span class="feature__num">02 ——</span><h3>You curate the showcase</h3><p>Toggle any section private. Pin your proudest achievements. Reorder. Hide losses.</p></div>
    <div class="feature"><span class="feature__num">03 ——</span><h3>Trophies, when CCP ships them</h3><p>Once they add them, I'll make them available here.. The moment a milestone unlocks in-game, it lands here.</p></div>
</section>
{% endblock %}
