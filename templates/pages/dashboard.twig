{% extends "layout/base.twig" %}
{% block title %}Dashboard — {{ pilot.name }}{% endblock %}
{% block content %}
<div class="dashboard">

    <header class="dashboard__header">
        <div class="dashboard__portrait">
            <img src="https://images.evetech.net/characters/{{ pilot.id }}/portrait?size=128" alt="{{ pilot.name }}">
        </div>
        <div class="dashboard__identity">
            <p class="dashboard__eyebrow">◇ YOUR REGISTRY</p>
            <h1 class="dashboard__title">{{ pilot.name }}</h1>
            {% if pilot.corporation_name %}
            <p class="dashboard__corp">
                {{ pilot.corporation_name }}
                {% if pilot.corporation_ticker %}[{{ pilot.corporation_ticker }}]{% endif %}
                {% if pilot.alliance_name %} · {{ pilot.alliance_name }}{% if pilot.alliance_ticker %} [{{ pilot.alliance_ticker }}]{% endif %}{% endif %}
            </p>
            {% endif %}
        </div>
        <div class="dashboard__visibility">
            <form method="POST" action="/dashboard/visibility">
                <button type="submit" class="btn btn--{{ pilot.is_public ? 'outline' : 'ghost' }}">
                    {{ pilot.is_public ? '⊙ PUBLIC' : '⊘ PRIVATE' }}
                </button>
            </form>
            {% if pilot.is_public %}
            <a href="/pilot/{{ pilot.name|url_encode }}" class="dashboard__profile-link">view public profile →</a>
            {% endif %}
        </div>
    </header>

    {% if app.session.saved is defined %}
    <div class="alert alert--success">Display selections saved.</div>
    {% endif %}

    <div class="dashboard__sections">

        {# ── Wallet ───────────────────────────────────────────────────────── #}
        <section class="data-section">
            <div class="data-section__header">
                <h2 class="section-title">◇ WALLET</h2>
                <a href="/auth/fetch/wallet" class="btn btn--outline btn--sm">
                    {{ session.fetched.wallet is defined ? '↻ REFRESH' : '→ LOAD' }}
                </a>
            </div>
            {% if session.fetched.wallet is defined %}
            <div class="data-section__body">
                <div class="stat">
                    <span class="stat__value">{{ session.fetched.wallet.balance|eve_number }} ISK</span>
                    <span class="stat__label">WALLET BALANCE</span>
                </div>
            </div>
            {% else %}
            <p class="data-section__empty">Authorise ESI to load your wallet balance.</p>
            {% endif %}
        </section>

                <form method="POST" action="/dashboard/display">
        {# ── Assets ───────────────────────────────────────────────────────── #}
        <section class="data-section">
            <div class="data-section__header">
                <h2 class="section-title">◇ ASSETS</h2>
                <a href="/auth/fetch/assets" class="btn btn--outline btn--sm">
                    {{ session.fetched.assets is defined ? '↻ REFRESH' : '→ LOAD' }}
                </a>
            </div>

            {% if session.fetched.assets is defined %}
            {% set assetData = session.fetched.assets %}
            <div class="data-section__body">
                <div class="stat-row" style="margin-bottom:1.5rem">
                    <div class="stat">
                        <span class="stat__value">{{ assetData.total_count|number_format }}</span>
                        <span class="stat__label">TOTAL ITEMS</span>
                    </div>
                    <div class="stat">
                        <span class="stat__value">{{ assetData.total_value|sig_figs }} ISK</span>
                        <span class="stat__label">EST. VALUE</span>
                    </div>
                    <div class="stat">
                        <span class="stat__value">{{ assetData.by_location|length }}</span>
                        <span class="stat__label">LOCATIONS</span>
                    </div>
                </div>

                {# Location breakdown #}
                <div class="asset-locations">
                    {% for loc in assetData.by_location %}
                    <details class="asset-location">
                        <summary class="asset-location__summary">
                            <span class="asset-location__name">{{ loc.location_name }}</span>
                            <span class="asset-location__count">{{ loc.item_count }} items</span>
                        </summary>
                        <table class="skill-table">
                            <thead><tr><th>Type</th><th>Qty</th></tr></thead>
                            <tbody>
                                {% for item in loc.items %}
                                <tr>
                                    <td>{{ item.type_name }}</td>
                                    <td>{{ item.quantity|number_format }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </details>
                    {% endfor %}
                </div>

                {# Searchable type list for display selection (inside the main form below) #}
                <div class="asset-select">
                    <h3 class="selection-group__title" style="margin-top:1.5rem">
                        SELECT ITEMS TO SHOW ON PUBLIC PROFILE
                        <span class="selection-group__hint">— quantity shown, no location</span>
                    </h3>
                    <input type="text" id="asset-search" placeholder="Filter types…" class="search-input">
                    <table class="skill-table" id="asset-table">
                        <thead><tr><th>Show</th><th>Type</th><th>Total Qty</th><th>Est. Value</th></tr></thead>                        
                        <tbody>
                            {% for item in assetData.all_types %}
                            <tr class="asset-row">
                                <td>
                                    <input type="checkbox"
                                           name="asset_{{ item.type_id }}"
                                           value="1"
                                           {% if selections.asset_ids is defined and selections.asset_ids[item.type_id] is defined %}checked{% endif %}>
                                </td>
                                <td>{{ item.type_name }}</td>
                                <td>{{ item.quantity|number_format }}</td>
                                <td>{{ item.total_value|sig_figs }} ISK</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% else %}
            <p class="data-section__empty">Authorise ESI to load your assets.</p>
            {% endif %}
        </section>

        {# ── Skills / Certs / Masteries ───────────────────────────────────── #}
        <section class="data-section">
            <div class="data-section__header">
                <h2 class="section-title">◇ SKILLS · CERTIFICATES · MASTERIES</h2>
                <a href="/auth/fetch/skills" class="btn btn--outline btn--sm">
                    {{ session.fetched.skills is defined ? '↻ REFRESH' : '→ LOAD' }}
                </a>
            </div>

            {% if session.fetched.skills is defined %}
            <div class="data-section__body">

                <div class="stat-row" style="margin-bottom:1.5rem">
                    <div class="stat">
                        <span class="stat__value">{{ (session.fetched.skills.total_sp / 1000000)|number_format(1) }}M</span>
                        <span class="stat__label">TOTAL SP</span>
                    </div>
                    <div class="stat">
                        <span class="stat__value">{{ session.fetched.skills.skills|length }}</span>
                        <span class="stat__label">SKILLS</span>
                    </div>
                    <div class="stat">
                        <span class="stat__value">{{ session.fetched.skills.certs|length }}</span>
                        <span class="stat__label">CERTS COMPLETED</span>
                    </div>
                    <div class="stat">
                        <span class="stat__value">{{ session.fetched.skills.masteries|length }}</span>
                        <span class="stat__label">SHIP MASTERIES</span>
                    </div>
                </div>


                    {# Skills #}
                    <div class="selection-group">
                        <h3 class="selection-group__title">SKILLS
                            <span class="selection-group__hint">— tick to show on your public profile</span>
                        </h3>
                        <table class="skill-table">
                            <thead>
                                <tr>
                                    <th>Show</th>
                                    <th>Skill</th>
                                    <th>Active</th>
                                    <th>Trained</th>
                                    <th>SP</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for skill in session.fetched.skills.skills %}
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               name="skill_{{ skill.skill_id }}"
                                               value="1"
                                    {% if selections.skill_ids[skill.skill_id] is defined %}checked{% endif %}>
                                    </td>
                                    <td>{{ skill.skill_name }}</td>
                                    <td>
                                        {% for i in 1..5 %}
                                        <span class="skill-pip skill-pip--{{ i <= skill.active_skill_level ? 'active' : (i <= skill.trained_skill_level ? 'trained' : 'empty') }}"></span>
                                        {% endfor %}
                                    </td>
                                    <td>
                                        {% for i in 1..5 %}
                                        <span class="skill-pip skill-pip--{{ i <= skill.trained_skill_level ? 'filled' : 'empty' }}"></span>
                                        {% endfor %}
                                    </td>
                                    <td>{{ (skill.skillpoints_in_skill / 1000)|number_format(0) }}K</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Certificates #}
                    {% if session.fetched.skills.certs|length > 0 %}
                    <div class="selection-group">
                        <h3 class="selection-group__title">CERTIFICATES
                            <span class="selection-group__hint">— highest completed level shown</span>
                        </h3>
                        <table class="skill-table">
                            <thead>
                                <tr>
                                    <th>Show</th>
                                    <th>Certificate</th>
                                    <th>Level</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for cert_id, cert in session.fetched.skills.certs %}
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               name="cert_{{ cert_id }}"
                                               value="1"
                                               {% if selections.cert_ids[cert_id] is defined %}checked{% endif %}>
                                    </td>
                                    <td>{{ cert.name }}</td>
                                    <td>
                                        {% for i in 1..5 %}
                                        <span class="skill-pip skill-pip--{{ i <= cert.level ? 'filled' : 'empty' }}"></span>
                                        {% endfor %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}

                    {# Masteries #}
                    {% if session.fetched.skills.masteries|length > 0 %}
                    <div class="selection-group">
                        <h3 class="selection-group__title">SHIP MASTERIES
                            <span class="selection-group__hint">— highest completed level shown</span>
                        </h3>
                        <table class="skill-table">
                            <thead>
                                <tr>
                                    <th>Show</th>
                                    <th>Ship</th>
                                    <th>Mastery</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for type_id, mastery in session.fetched.skills.masteries %}
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               name="mastery_{{ type_id }}"
                                               value="1"
                                               {% if selections.mastery_ids[type_id] is defined %}checked{% endif %}>
                                    </td>
                                    <td>
                                        <img src="https://images.evetech.net/types/{{ type_id }}/icon?size=32"
                                             alt="{{ mastery.name }}"
                                             style="width:32px;height:32px;vertical-align:middle;margin-right:0.4rem;">
                                        {{ mastery.name }}
                                    </td>
                                    <td>
                                        {% for i in 1..5 %}
                                        <span class="skill-pip skill-pip--{{ i <= mastery.level ? 'filled' : 'empty' }}"></span>
                                        {% endfor %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}

                    <div class="form-actions">
                        <div class="display-toggles">
                            <label class="display-toggle">
                                <input type="checkbox" name="show_sp" value="1"
                                    {% if selections.show_sp %}checked{% endif %}
                                    {% if session.fetched.skills is not defined %}disabled title="Load skills first"{% endif %}>
                                <span>Show SP ({{ session.fetched.skills is defined ? (session.fetched.skills.total_sp|sig_figs ~ ' SP') : 'load skills first' }})</span>
                            </label>
                            <label class="display-toggle">
                                <input type="checkbox" name="show_isk" value="1"
                                    {% if selections.show_isk %}checked{% endif %}
                                    {% if session.fetched.wallet is not defined %}disabled title="Load wallet first"{% endif %}>
                                <span>Show ISK ({{ session.fetched.wallet is defined ? (session.fetched.wallet.balance|sig_figs ~ ' ISK') : 'load wallet first' }})</span>
                            </label>
                            <label class="display-toggle">
                                <input type="checkbox" name="show_assets" value="1"
                                    {% if selections.show_assets %}checked{% endif %}
                                    {% if session.fetched.assets is not defined %}disabled title="Load assets first"{% endif %}>
                                <span>Show asset value ({{ session.fetched.assets is defined ? (session.fetched.assets.total_value|sig_figs ~ ' ISK') : 'load assets first' }})</span>
                            </label>
                        </div>
                        <button type="submit" class="btn btn--primary">SAVE DISPLAY SELECTIONS</button>
                    </div>

                </form>
            </div>
            {% else %}
            <p class="data-section__empty">Authorise ESI to load skills, certificates and masteries.</p>
            {% endif %}
        </section>

    </div>

    <div class="dashboard__actions">
        <a href="/auth/logout" class="btn btn--ghost">LOGOUT</a>
    </div>
</div>
{% endblock %}

