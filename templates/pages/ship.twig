{% extends "layout/base.twig" %}
{% block title %}{{ ship.name }}{% endblock %}

{# Link preview (Discord, Slack, …). Generic SDE data only, nothing about any pilot #}
{% block head %}
    {% set cert_names = requirements[level]|map(c => c.name)|join(', ') %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="EVEchievements">
    <meta property="og:title" content="{{ ship.name }} — Mastery {{ roman[level] }}">
    <meta property="og:description" content="{{ ship.group_name }}{{ ship.faction_name ? ' · ' ~ ship.faction_name }}. Mastery {{ roman[level] }} needs {{ requirements[level]|length }} certificates: {{ cert_names|slice(0, 200) }}{{ cert_names|length > 200 ? '…' }}">
    <meta property="og:url" content="{{ app_url }}/ship/{{ ship.type_id }}?level={{ level }}">
    <meta property="og:image" content="https://images.evetech.net/types/{{ ship.type_id }}/render?size=128">
    <meta name="theme-color" content="#f4a228">
{% endblock %}
{% set roman = ['', 'I', 'II', 'III', 'IV', 'V'] %}

{# One required skill. `have` is the logged-in viewer's own level (from their session) or null:
   only ever shown to that viewer, never stored or shown to anyone else. #}
{% macro skill_row(skill, roman, have = null, note = null) %}
    {% set met = have is not null and have >= skill.level %}
    <li class="req-skill{{ have is not null ? (met ? ' req-skill--met' : ' req-skill--missing') }}">
        <span class="req-skill__name">{% if skill.skill_id is defined %}<span class="skill-name" data-skill-id="{{ skill.skill_id }}" tabindex="0">{{ skill.name }}</span>{% else %}{{ skill.name }}{% endif %}{% if have is not null and not met %} <span class="req-skill__gap">{{ roman[have] ?: '0' }} → {{ roman[skill.level] }}</span>{% endif %}{% if note %} <span class="req-skill__note">{{ note }}</span>{% endif %}</span>
        <span class="req-skill__level" title="Level {{ skill.level }} required{{ have is not null ? ', you have ' ~ have }}">
            {% for i in 1..5 %}
                {% if have is null %}<span class="skill-pip skill-pip--{{ i <= skill.level ? 'filled' : 'empty' }}"></span>
                {% else %}<span class="skill-pip skill-pip--{{ i <= have ? 'filled' : (i <= skill.level ? 'needed' : 'empty') }}"></span>{% endif %}
            {% endfor %}
        </span>
    </li>
{% endmacro %}

{% block content %}
<div class="shiptree">

    <header class="ship-header">
        <img class="ship-header__render" src="https://images.evetech.net/types/{{ ship.type_id }}/render?size=128" alt="{{ ship.name }}">
        <div class="ship-header__identity">
            <span class="shiptree__eyebrow">◇ SHIP{% if ship.faction_name %} · {{ ship.faction_name|upper }}{% endif %}</span>
            <h1 class="shiptree__pilot-name">{{ ship.name }}</h1>
            <p class="ship-header__group">{{ ship.group_name }}{% if ship.tech_level > 1 %} · Tech {{ roman[ship.tech_level] }}{% endif %}</p>
        </div>
    </header>

    <section class="data-section ship-section">
        <div class="data-section__header">
            <h2 class="section-title">◇ REQUIRED TO FLY</h2>
            {% if mine.loaded ?? false %}
            {# The viewer's own state, from their session: not stored, not shown to anyone else #}
            <span class="fly-status{{ mine.can_fly ? ' fly-status--ok' }}">
                {{ mine.can_fly ? '✓ You can fly this ship' : '≈ ' ~ mine.fly_minutes|duration ~ ' of training to fly it' }}
            </span>
            {% endif %}
        </div>
        <div class="data-section__body">
            {% if (mine.loaded ?? false) and not mine.can_fly %}
            <ul class="req-skills viewer-progress__list">
                {% for gap in mine.fly_missing %}
                    {{ _self.skill_row({skill_id: gap.skill_id, name: gap.name, level: gap.need}, roman, gap.have,
                        (gap.prerequisite ? 'prerequisite · ' : '') ~ '≈ ' ~ gap.minutes|duration) }}
                {% endfor %}
            </ul>
            <p class="viewer-progress__note">Only you can see this. Times count skill points you've already earned, at 20 in both attributes (Omega, no implants).</p>
            {% else %}
            <ul class="req-skills">
                {% for skill in fly_skills %}
                    {{ _self.skill_row(skill, roman, mine.loaded ?? false ? (mine.skills[skill.skill_id] ?? 0) : null) }}
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </section>

    {% if mine is not null and not mine.loaded %}
    <p class="viewer-note">Load your skills on the <a href="/dashboard">dashboard</a> to see which skills you're missing for this ship. Only you see that.</p>
    {% endif %}

    {# Every tab is rendered; app.js switches them in place and keeps ?level= / ?tab= in the URL.
       Without JS the tabs are plain links. #}
    {% set tabs = [] %}
    {% for l in 1..5 %}{% set tabs = tabs|merge([{id: 'level-' ~ l, query: 'level=' ~ l, label: 'MASTERY ' ~ roman[l] ~ ((mine.loaded ?? false) and l <= mine.mastery ? ' ✓' : '')}]) %}{% endfor %}
    {% set tabs = tabs|merge([
        {id: 'attributes', query: 'tab=attributes', label: 'ATTRIBUTES'},
        {id: 'bonuses',    query: 'tab=bonuses',    label: 'BONUSES'},
    ]) %}
    <nav class="level-tabs" role="tablist">
        {% for t in tabs %}
        <a href="?{{ t.query }}" id="tab-{{ t.id }}" role="tab" data-panel="panel-{{ t.id }}" data-query="{{ t.query }}"
           aria-controls="panel-{{ t.id }}" aria-selected="{{ t.id == active ? 'true' : 'false' }}"
           class="level-tab{{ t.id == active ? ' level-tab--active' }}">
            {{ t.label }}
        </a>
        {% endfor %}
    </nav>

    {% for l in 1..5 %}
    <section class="cert-grid" id="panel-level-{{ l }}" role="tabpanel" aria-labelledby="tab-level-{{ l }}"{{ active != 'level-' ~ l ? ' hidden' }}>
        {% if mine.loaded ?? false %}
        {# The viewer's own progress, from their session: not stored, not shown to anyone else #}
        <article class="cert-card viewer-progress{{ l <= mine.mastery ? ' viewer-progress--done' }}">
            {% if l <= mine.mastery %}
            <h3 class="cert-card__name">✓ You have Mastery {{ roman[l] }}</h3>
            {% else %}
            <h3 class="cert-card__name">
                <span>
                    You're missing {{ mine.missing[l]|length }} skill{{ mine.missing[l]|length == 1 ? '' : 's' }} for Mastery {{ roman[l] }}
                    <span class="viewer-progress__time">≈ {{ mine.minutes[l]|duration }} of training</span>
                </span>
                <span class="cert-card__count">only you can see this</span>
            </h3>
            <ul class="req-skills viewer-progress__list">
                {% for gap in mine.missing[l] %}
                    {{ _self.skill_row({skill_id: gap.skill_id, name: gap.name, level: gap.need}, roman, gap.have,
                        (gap.prerequisite ? 'prerequisite · ' : '') ~ '≈ ' ~ gap.minutes|duration) }}
                {% endfor %}
            </ul>
            <p class="viewer-progress__note">
                {% if not mine.can_fly %}Includes the skills needed to fly the ship (see Required to fly). {% endif %}
                Times count skill points you've already earned, at 20 in both attributes (Omega, no implants); hover a skill for its full details.
            </p>
            {% endif %}
        </article>
        {% endif %}
        {% for cert in requirements[l] %}
        {% set have_met = (mine.loaded ?? false) ? cert.skills|filter(s => (mine.skills[s.skill_id] ?? 0) >= s.level)|length : null %}
        <article class="cert-card">
            <h3 class="cert-card__name" title="{{ cert.description }}">
                {{ cert.name }} {{ roman[l] }}
                <span class="cert-card__count">{{ have_met is not null ? have_met ~ '/' ~ cert.skills|length ~ ' skills' : cert.skills|length ~ ' skills' }}</span>
            </h3>
            <ul class="req-skills">
                {% for skill in cert.skills %}
                    {{ _self.skill_row(skill, roman, (mine.loaded ?? false) ? (mine.skills[skill.skill_id] ?? 0) : null) }}
                {% endfor %}
            </ul>
        </article>
        {% else %}
        <p class="empty-state">No certificates listed for this level.</p>
        {% endfor %}
    </section>
    {% endfor %}

    <section class="cert-grid" id="panel-attributes" role="tabpanel" aria-labelledby="tab-attributes"{{ active != 'attributes' ? ' hidden' }}>
        {% for group in attributes %}
        <article class="cert-card">
            <h3 class="cert-card__name">{{ group.category }}</h3>
            <dl class="attr-list">
                {% for attr in group.attributes %}
                <div class="attr-list__row">
                    <dt>{{ attr.name }}</dt>
                    <dd>{{ attr.value }}</dd>
                </div>
                {% endfor %}
            </dl>
        </article>
        {% else %}
        <p class="empty-state">No attributes listed for this ship.</p>
        {% endfor %}
    </section>

    <section class="cert-grid cert-grid--wide" id="panel-bonuses" role="tabpanel" aria-labelledby="tab-bonuses"{{ active != 'bonuses' ? ' hidden' }}>
        {% for group in bonuses %}
        <article class="cert-card">
            <h3 class="cert-card__name">{{ group.title }}</h3>
            <ul class="bonus-list">
                {% for bonus in group.bonuses %}
                <li class="bonus-list__item">
                    <span class="bonus-list__amount">{{ bonus.amount ?? '◇' }}</span>
                    <span>{{ bonus.text }}</span>
                </li>
                {% endfor %}
            </ul>
        </article>
        {% else %}
        <p class="empty-state">This ship has no bonuses listed.</p>
        {% endfor %}
    </section>

</div>
{% endblock %}
